<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SPTOptimizer</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.0</Version>
    <Company>tarkov-modified-mods</Company>
    <Description>SPT memory and CPU optimizer plugin for BepInEx 5 with Linux/Proton support</Description>
    <Copyright>Copyright 2025</Copyright>
    <SptInstallPath Condition="'$(SptInstallPath)' == ''">C:\Battlestate Games\SPP-Tarkov</SptInstallPath>
  </PropertyGroup>

  <!-- Reference path -->
  <PropertyGroup>
    <RefPath Condition="'$(RefPath)' == '' and Exists('$(MSBuildThisFileDirectory)../MiyakoCarryService/Ref')">$(MSBuildThisFileDirectory)../MiyakoCarryService/Ref</RefPath>
    <SptModulesPath>$(MSBuildThisFileDirectory)../../SPT/modules</SptModulesPath>
    <SharedManagedPath Condition="Exists('$(SptModulesPath)/Shared/Managed')">$(SptModulesPath)/Shared/Managed</SharedManagedPath>
    <SharedManagedPath Condition="'$(SharedManagedPath)' == ''">$(RefPath)</SharedManagedPath>
  </PropertyGroup>

  <!-- BepInEx + Harmony via NuGet -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8"
      PrivateAssets="All"
      IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
      ExcludeAssets="runtime" PrivateAssets="all">
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- EFT / Unity game DLL references -->
  <ItemGroup>
    <Reference Include="0Harmony"                   HintPath="$(RefPath)/0Harmony.dll" Private="False" />
    <Reference Include="Assembly-CSharp"             HintPath="$(RefPath)/Assembly-CSharp.dll" Private="False" />
    <Reference Include="Comfort"                     HintPath="$(RefPath)/Comfort.dll"   Private="False" />
    <Reference Include="Comfort.Unity"               HintPath="$(RefPath)/Comfort.Unity.dll" Private="False" />
    <Reference Include="UnityEngine"                 HintPath="$(RefPath)/UnityEngine.dll" Private="False" />
    <Reference Include="UnityEngine.CoreModule"      HintPath="$(RefPath)/UnityEngine.CoreModule.dll" Private="False" />
    <Reference Include="UnityEngine.AudioModule"     HintPath="$(RefPath)/UnityEngine.AudioModule.dll" Private="False" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(RefPath)/UnityEngine.AssetBundleModule.dll" Private="False" />
    <Reference Include="UnityEngine.AnimationModule" HintPath="$(RefPath)/UnityEngine.AnimationModule.dll" Private="False" />
    <Reference Include="UnityEngine.ClothModule"     HintPath="$(RefPath)/UnityEngine.ClothModule.dll" Private="False" />
    <Reference Include="UnityEngine.PhysicsModule"   HintPath="$(RefPath)/UnityEngine.PhysicsModule.dll" Private="False" />
    <Reference Include="UnityEngine.ParticleSystemModule" HintPath="$(RefPath)/UnityEngine.ParticleSystemModule.dll" Private="False" />
    <Reference Include="UnityEngine.IMGUIModule"     HintPath="$(RefPath)/UnityEngine.IMGUIModule.dll" Private="False" />
    <Reference Include="UnityEngine.UIModule"        HintPath="$(RefPath)/UnityEngine.UIModule.dll" Private="False" />
    <Reference Include="UnityEngine.UI"              HintPath="$(RefPath)/UnityEngine.UI.dll" Private="False" />
    <Reference Include="Newtonsoft.Json"             HintPath="$(RefPath)/Newtonsoft.Json.dll" Private="False" />
  </ItemGroup>

  <!-- SPT reflection/common DLL -->
  <ItemGroup>
    <Reference Include="spt-reflection"
      HintPath="$(RefPath)/spt-reflection.dll"
      Private="False" />
    <Reference Include="spt-common"
      HintPath="$(RefPath)/spt-common.dll"
      Private="False" />
  </ItemGroup>

  <!-- Post-build: copy to SPT BepInEx plugins folder -->
  <Target Name="CopyToSPT" AfterTargets="Build" Condition="Exists('$(SptInstallPath)\BepInEx\plugins\')">
    <Copy
      SourceFiles="$(OutputPath)$(AssemblyName).dll"
      DestinationFolder="$(SptInstallPath)\BepInEx\plugins\"
      SkipUnchangedFiles="false" />
    <Message Text="[Auto-Deploy] Copied $(AssemblyName).dll to $(SptInstallPath)\BepInEx\plugins\" Importance="high" />
  </Target>

</Project>